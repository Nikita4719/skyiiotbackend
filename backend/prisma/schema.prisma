generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model about_us {
  id         Int       @id @default(autoincrement())
  title      String?   @db.LongText
  heading    String?   @db.LongText
  paragraph  String?   @db.LongText
  image1     String?   @db.VarChar(255)
  image2     String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model aboutusbenefits {
  id         Int       @id @default(autoincrement())
  heading1   String?   @db.LongText
  heading2   String?   @db.LongText
  heading3   String?   @db.LongText
  heading4   String?   @db.LongText
  heading5   String?   @db.LongText
  heading6   String?   @db.LongText
  heading7   String?   @db.LongText
  heading8   String?   @db.LongText
  paragraph1 String?   @db.LongText
  paragraph2 String?   @db.LongText
  paragraph3 String?   @db.LongText
  paragraph4 String?   @db.LongText
  images     Json?
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model aboutusenterprise {
  id         Int       @id @default(autoincrement())
  heading    String?   @db.Text
  paragraph  String?   @db.Text
  image1     String?   @db.VarChar(255)
  image2     String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model ai_powered {
  id         Int       @id @default(autoincrement())
  heading1   String?   @db.Text
  heading2   String?   @db.Text
  heading3   String?   @db.Text
  paragraph1 String?   @db.Text
  paragraph2 String?   @db.Text
  media      String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model cloudsection {
  id         Int     @id @default(autoincrement())
  heading    String? @db.LongText
  paragraph1 String? @db.LongText
  paragraph2 String? @db.LongText
  image1     String? @db.VarChar(255)
  image2     String? @db.VarChar(255)
  image3     String? @db.VarChar(255)
  image4     String? @db.VarChar(255)
}

model cms_faqs {
  id         Int       @id @default(autoincrement())
  faq_id     Int?
  para       String?   @db.Text
  created_at DateTime? @default(now()) @db.Timestamp(0)
  faqs       faqs?     @relation(fields: [faq_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "cms_faqs_ibfk_1")

  @@index([faq_id], map: "faq_id")
}

model everywhere_slide {
  id         Int       @id @default(autoincrement())
  created_at DateTime? @default(now()) @db.Timestamp(0)
  heading    String?   @db.Text
  image      String?   @db.VarChar(255)
  paragraph  String?   @db.Text
}

model faqs {
  id         Int        @id @default(autoincrement())
  title      String?    @db.VarChar(255)
  created_at DateTime?  @default(now()) @db.Timestamp(0)
  cms_faqs   cms_faqs[]
}

model image_button_section {
  id        Int     @id @default(autoincrement())
  heading   String? @db.VarChar(255)
  paragraph String? @db.Text
  image     String? @db.VarChar(255)
}

model managementsection {
  id         Int     @id @default(autoincrement())
  heading    String? @db.LongText
  paragraph1 String? @db.LongText
  paragraph2 String? @db.LongText
  image1     String? @db.VarChar(255)
  image2     String? @db.VarChar(255)
  image3     String? @db.VarChar(255)
  image4     String? @db.VarChar(255)
}

model networksection {
  id         Int     @id @default(autoincrement())
  heading    String? @db.LongText
  paragraph1 String? @db.LongText
  paragraph2 String? @db.LongText
  image1     String? @db.VarChar(255)
  image2     String? @db.VarChar(255)
  image3     String? @db.VarChar(255)
  image4     String? @db.VarChar(255)
}

model offer {
  id         Int       @id @default(autoincrement())
  title      String?   @db.Text
  heading1   String?   @db.Text
  heading2   String?   @db.Text
  heading3   String?   @db.Text
  heading4   String?   @db.Text
  heading5   String?   @db.Text
  paragraph1 String?   @db.Text
  paragraph2 String?   @db.Text
  paragraph3 String?   @db.Text
  paragraph4 String?   @db.Text
  image1     String?   @db.VarChar(255)
  image2     String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model orders {
  id         Int       @id @default(autoincrement())
  image      String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model our_team {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  heading   String?  @db.Text
  image     String?
  paragraph String?  @db.Text
}

model services {
  id         Int                 @id @default(autoincrement())
  title      String?             @db.Text
  heading    String?             @db.Text
  paragraph  String?             @db.LongText
  created_at DateTime?           @default(now()) @db.Timestamp(0)
  image      String?             @db.VarChar(255)
  categories services_category[]
}

model services_category {
  id         Int                @id @default(autoincrement())
  service_id Int
  icon       String?            @db.VarChar(255)
  link       String?            @db.Text
  created_at DateTime?          @default(now()) @db.Timestamp(0)
  service    services           @relation(fields: [service_id], references: [id], onDelete: Cascade)
  details    services_sub_cat[]

  @@index([service_id], map: "services_category_service_id_fkey")
}

model services_sub_cat {
  id                   Int               @id @default(autoincrement())
  services_category_id Int
  title                String?           @db.Text
  description          String?           @db.LongText
  image                String?           @db.VarChar(255)
  subheading           String?           @db.Text
  subspan1             String?           @db.Text
  subspan2             String?           @db.Text
  subtitle_para1       String?           @db.LongText
  subtitle_para2       String?           @db.LongText
  created_at           DateTime?         @default(now()) @db.Timestamp(0)
  imagebg              String?           @db.VarChar(255)
  category             services_category @relation(fields: [services_category_id], references: [id], onDelete: Cascade)

  @@index([services_category_id], map: "services_sub_cat_services_category_id_fkey")
}

model slides {
  id         Int       @id @default(autoincrement())
  title      String?   @db.VarChar(255)
  media      String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model smarter_section {
  id         Int                         @id @default(autoincrement())
  heading    String?                     @db.LongText
  para       String?                     @db.LongText
  media      String?                     @db.VarChar(255)
  media_type smarter_section_media_type?
  created_at DateTime?                   @default(now()) @db.Timestamp(0)
}

model solution_cat {
  id                      Int                       @id @default(autoincrement())
  title                   String                    @db.VarChar(255)
  image                   String?                   @db.VarChar(255)
  created_at              DateTime?                 @default(now()) @db.Timestamp(0)
  solution_sub_categories solution_sub_categories[]
}

model solution_images {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(255)
  image1     String?   @db.VarChar(255)
  image2     String?   @db.VarChar(255)
  image3     String?   @db.VarChar(255)
  image4     String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  imagechart String?   @db.VarChar(255)
}

model solution_sub_categories {
  id            Int           @id @default(autoincrement())
  solutionCatId Int?
  heading       String?       @db.Text
  description1  String?       @db.Text
  description2  String?       @db.Text
  image1        String?       @db.VarChar(255)
  imagechart    String?       @db.VarChar(255)
  para1         String?       @db.Text
  para2         String?       @db.Text
  para3         String?       @db.Text
  para4         String?       @db.Text
  image2        String?       @db.Text
  created_at    DateTime?     @default(now()) @db.Timestamp(0)
  solution_cat  solution_cat? @relation(fields: [solutionCatId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "solution_sub_categories_ibfk_1")

  @@index([solutionCatId], map: "solutionCatId")
}

model supported_content {
  id         Int       @id @default(autoincrement())
  heading    String?   @db.Text
  paragraph1 String?   @db.Text
  paragraph2 String?   @db.Text
  image1     String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  image2     String?   @db.VarChar(255)
  image3     String?   @db.VarChar(255)
  image4     String?   @db.VarChar(255)
}

model testimonials {
  id         Int       @id @default(autoincrement())
  heading    String    @db.VarChar(255)
  para1      String?   @db.Text
  para2      String?   @db.Text
  image1     String?   @db.VarChar(255)
  image2     String?   @db.VarChar(255)
  image3     String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model users {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  email      String    @unique(map: "email") @db.VarChar(100)
  password   String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model what_section {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String?   @db.Text
  image       String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
}

model contact_messages {
  id         Int       @id @default(autoincrement())
  first_name String?   @db.VarChar(255)
  last_name  String?   @db.VarChar(255)
  email      String?   @db.VarChar(255)
  phone      String?   @db.VarChar(20)
  message    String?   @db.Text
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
}

model Footer {
  id            Int      @id @default(autoincrement())
  contact_email String
  contact_phone String
  address       String
  qr_code       String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  content       String?
  title         String?
  links         Json?
  logo          String?  @db.VarChar(255)

  @@map("footer")
}

model header_top {
  id            Int     @id @default(autoincrement())
  phone         String? @db.VarChar(50)
  email         String? @db.VarChar(100)
  facebook_link String? @db.VarChar(255)
  twitter_link  String? @db.VarChar(255)
  linkedin_link String? @db.VarChar(255)
  youtube_link  String? @db.VarChar(255)
}

model navbar_logo {
  id           Int     @id @default(autoincrement())
  logo         String? @db.VarChar(255)
  logo_text    String? @db.VarChar(255)
  logo_tagline String? @db.VarChar(255)
}

model navbar_menu {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(255)
  link      String  @db.VarChar(255)
  order_no  Int?
  is_button Boolean @default(false)
}

model contact_settings {
  id       Int     @id @default(autoincrement())
  map_url  String? @db.Text
  bg_image String? @db.VarChar(255)
}

model embedded {
  id         Int       @id @default(autoincrement())
  heading    String?   @db.Text
  paragraph1 String?   @db.LongText
  paragraph2 String?   @db.LongText
  image1     String?   @db.VarChar(255)
  image2     String?   @db.VarChar(255)
  image3     String?   @db.VarChar(255)
  image4     String?   @db.VarChar(255)
  video      String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

enum smarter_section_media_type {
  image
  video
}
